{
  "name": "testingpart2",
  "version": "1.0.0",
  "type": "module",

  "scripts": {
    "test": "mocha \"test/**/*.test.js\"",
    "test:watch": "mocha --watch \"test/**/*.test.js\"",
    "coverage": "c8 --reporter=text --reporter=lcov mocha \"test/**/*.test.js\"",
    "coverage:check": "npx nyc --check-coverage npm test"
  },

  "nyc": {
    "all": true,
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "report-dir": "coverage"
  },

  "devDependencies": {
    "chai": "^6.3.0",
    "c8": "^10.0.0",
    "mocha": "^12.0.3"
  }
}
